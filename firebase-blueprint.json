{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores player progression, currency, and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "currency": { "type": "number", "description": "In-game currency for garage" },
        "totalScore": { "type": "number" },
        "wins": { "type": "number" },
        "level": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "currency", "totalScore"]
    },
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A single entry on the global leaderboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "score": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "score", "timestamp"]
    },
    "Newsletter": {
      "title": "Newsletter Subscription",
      "description": "Emails for beta access and updates.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "subscribedAt"]
    },
    "PatchNote": {
      "title": "Patch Note",
      "description": "Game updates and bug fixes.",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["version", "title", "content", "date"]
    },
    "DownloadStat": {
      "title": "Download Statistic",
      "description": "Tracks game downloads.",
      "type": "object",
      "properties": {
        "platform": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ip": { "type": "string" }
      },
      "required": ["platform", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Global user documents."
    },
    "leaderboard/{entryId}": {
      "schema": "LeaderboardEntry",
      "description": "Global competitive scores."
    },
    "newsletters/{subscriptionId}": {
      "schema": "Newsletter",
      "description": "Store newsletter signups."
    },
    "patches/{patchId}": {
      "schema": "PatchNote",
      "description": "Display latest updates."
    },
    "downloads/{downloadId}": {
      "schema": "DownloadStat",
      "description": "Track download conversion."
    }
  }
}
