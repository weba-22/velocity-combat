{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores player progression, currency, and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "currency": { "type": "number", "description": "In-game currency for garage" },
        "totalScore": { "type": "number" },
        "wins": { "type": "number" },
        "level": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "currency", "totalScore"]
    },
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A single entry on the global leaderboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "score": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "score", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Global user documents."
    },
    "leaderboard/{entryId}": {
      "schema": "LeaderboardEntry",
      "description": "Global competitive scores."
    }
  }
}
