rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 50 &&
             data.currency is number && data.currency >= 0 &&
             data.totalScore is number &&
             data.level is number &&
             data.createdAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 50 &&
             data.score is number &&
             data.timestamp == request.time;
    }

    function isValidNewsletterSubscriber(data) {
      return data.email is string && data.email.size() <= 200 &&
             data.subscribedAt == request.time;
    }

    function isValidPatchNote(data) {
      return data.version is string && data.version.size() <= 20 &&
             data.title is string && data.title.size() <= 100 &&
             data.content is string && data.content.size() <= 5000 &&
             data.date == request.time;
    }

    function isValidDownloadStat(data) {
      return data.platform is string &&
             data.timestamp == request.time;
    }

    // --- Collection Routes ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; 
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['totalScore', 'wins', 'level', 'currency', 'displayName'])
      );
    }

    match /leaderboard/{entryId} {
      allow get: if true;
      allow list: if true; 
      
      allow create: if isSignedIn() && isValidId(entryId) && isValidLeaderboardEntry(incoming());
      allow update, delete: if false; 
    }

    match /newsletters/{subscriptionId} {
      allow create: if isValidNewsletterSubscriber(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /patches/{patchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow create: if isValidDownloadStat(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Only manageable via Firebase Console or special script
    }
  }
}
